# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.

# --- Hindsight -----------------------------------------------------------------------------
# Hindsight Cloud:  HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io  + HINDSIGHT_API_KEY
# Local server:     HINDSIGHT_BASE_URL=http://localhost:8888  (leave HINDSIGHT_API_KEY empty)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Optional tuning
HINDSIGHT_TIMEOUT_S=900
HINDSIGHT_MAX_ATTEMPTS=3
# Every bank ReviewMind creates starts with this prefix, e.g. reviewmind-acme-payments
HINDSIGHT_BANK_PREFIX=reviewmind
REVIEWMIND_TEAM=acme-payments
